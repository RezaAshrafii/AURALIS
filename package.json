{
  "name": "auralis-source-foundation",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "frontend:typecheck": "tsc --project apps/web/tsconfig.json --noEmit",
    "frontend:test": "node --test \"tests/frontend-foundation.test.mjs\"",
    "frontend:build": "node scripts/build-web.mjs",
    "build:v0.11:test": "node scripts/build-v011-test.mjs",
    "build:v0.12:windows-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-v012-windows-test.ps1",
    "audio-core:fmt": "cargo fmt --manifest-path native/Cargo.toml --all -- --check",
    "audio-core:clippy": "cargo clippy --manifest-path native/Cargo.toml --workspace --all-targets --locked -- -D warnings",
    "audio-core:test": "cargo test --manifest-path native/Cargo.toml --workspace --locked",
    "speech:test": "node --test \"tests/v013-speech-engine.test.mjs\"",
    "speech:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-v013-speech-gate.ps1",
    "build:v0.13:windows-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-v013-windows-speech-test.ps1"
  }
}
