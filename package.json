{
  "name": "auralis-source-foundation",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun server.mjs",
    "start": "bun server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "runtime:check": "node --check server.mjs",
    "frontend:typecheck": "tsc --project apps/web/tsconfig.json --noEmit",
    "frontend:test": "node --test \"tests/frontend-foundation.test.mjs\"",
    "frontend:build": "node scripts/build-web.mjs",
    "build:v0.11:test": "node scripts/build-v011-test.mjs",
    "build:v0.12:windows-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-v012-windows-test.ps1",
    "audio-core:fmt": "cargo fmt --manifest-path native/Cargo.toml --all -- --check",
    "audio-core:clippy": "cargo clippy --manifest-path native/Cargo.toml --workspace --all-targets --locked -- -D warnings",
    "audio-core:test": "cargo test --manifest-path native/Cargo.toml --workspace --locked",
    "speech:test": "node --test \"tests/v013-speech-engine.test.mjs\"",
    "intelligence:test": "node --test \"tests/v014-intelligence-layer.test.mjs\"",
    "intelligence:benchmark": "node scripts/run-v014-benchmarks.mjs",
    "intelligence:gate": "npm run intelligence:test && npm run intelligence:benchmark && npm run frontend:typecheck && npm run frontend:build",
    "intelligence:gate:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-v014-intelligence-gate.ps1",
    "speech:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-v013-speech-gate.ps1",
    "build:v0.13:windows-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-v013-windows-speech-test.ps1",
    "build:v0.14:windows-bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-v014-windows-product-bridge.ps1",
    "audio-bridge:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-v014-product-bridge-gate.ps1",
    "v015:test": "node --test tests/v015-product-experience.test.mjs",
    "v015:benchmark": "node scripts/benchmark-v015-product.mjs",
    "v016:test": "node --test tests/v016-memory-engine.test.mjs",
    "v016:benchmark": "node scripts/benchmark-v016-memory.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11"
  }
}
